{
  "name": "@rowan-ui/icons",
  "version": "0.7.0",
  "description": "Optional, tree-shakable SVG icons for Rowan.",
  "license": "MIT AND ISC",
  "author": "2351Labs",
  "homepage": "https://2351labs.github.io/rowan/?path=/docs/foundations-icons--docs",
  "bugs": {
    "url": "https://github.com/2351Labs/rowan/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2351Labs/rowan.git",
    "directory": "packages/icons"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "icons",
    "svg",
    "web-components",
    "rowan"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "types": "./types/index.d.ts",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "customElements": "custom-elements.json",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./icons": {
      "types": "./types/icons/index.d.ts",
      "default": "./src/icons/index.js"
    },
    "./icons/*": {
      "types": "./types/icons/*.d.ts",
      "default": "./src/icons/*.js"
    },
    "./element": {
      "types": "./src/element.d.ts",
      "default": "./src/element.js"
    },
    "./elements/*": {
      "types": "./src/elements.d.ts",
      "default": "./src/elements/*.js"
    },
    "./react": {
      "types": "./src/react/generated/index.d.ts",
      "default": "./src/react/generated/index.js"
    },
    "./react/icon": {
      "types": "./src/react/generated/icon.d.ts",
      "default": "./src/react/generated/icon.js"
    }
  },
  "files": [
    "src/element.css",
    "src/element.d.ts",
    "src/element.js",
    "src/elements.d.ts",
    "src/elements",
    "src/index.js",
    "src/icon.js",
    "src/icons",
    "src/react",
    "types",
    "custom-elements.json",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": [
    "./src/element.js",
    "./src/elements/*.js"
  ],
  "peerDependencies": {
    "@rowan-ui/core": "^0.7.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@rowan-ui/core": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rowan-ui/core": "file:../..",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@web/test-runner": "^0.18.2",
    "@web/test-runner-playwright": "^0.11.0",
    "@xmldom/xmldom": "^0.8.10",
    "eslint": "^8.57.1",
    "lucide-static": "^1.45.0",
    "prettier": "^3.0.0",
    "typescript": "~5.4.5"
  },
  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.js",
    "generate": "node ./scripts/generate-icons.mjs",
    "verify": "node ./scripts/verify-icons.mjs",
    "types": "node ./scripts/clean-types.mjs && tsc --project tsconfig.types.json",
    "typecheck": "tsc --project tsconfig.typecheck.json",
    "test": "web-test-runner \"src/**/*.test.js\" --node-resolve --concurrency=1",
    "test:browser": "web-test-runner \"src/**/*.test.js\" --node-resolve --config web-test-runner.playwright.config.js --concurrency=1",
    "lint": "eslint \"src/**/*.js\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"**/*.{js,mjs,md,json}\"",
    "pack:check": "npm pack --dry-run --json"
  }
}

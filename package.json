  "scripts": {
    "analyze": "cem analyze --config custom-elements-manifest.config.js && npm run analyze --workspace=@rowan-ui/icons && npm run analyze --workspace=@rowan-ui/maplibre && node ./scripts/check-cem-public-api.mjs && node ./scripts/generate-react-wrappers.mjs",
    "storybook": "storybook dev -p 6006",
    "documentation": "vite --open /documentation/index.html",
    "documentation:build": "vite build --config documentation/vite.build.mjs",
    "build-storybook": "storybook build",
    "test": "web-test-runner \"{src,packages/*/src,test-fixtures/*}/**/*.test.js\" --node-resolve --config web-test-runner.config.js --concurrency=1",
    "test:package": "node ./scripts/check-registration-side-effects.mjs",
    "test:browser": "web-test-runner \"{src,packages/*/src}/**/*.test.js\" --node-resolve --config web-test-runner.playwright.config.js --concurrency=1",
    "benchmark": "node ./scripts/run-benchmarks.mjs && prettier --write benchmarks/RESULTS.md benchmarks/results/latest.json",
    "tokens:sync": "node ./scripts/sync-token-sheet.mjs",
    "tokens:check": "node ./scripts/sync-token-sheet.mjs --check",
    "css:check": "node ./scripts/check-css-tokens.mjs",
    "types": "node ./scripts/clean-types.mjs && tsc --project tsconfig.types.json && node ./scripts/refine-generated-declarations.mjs && npm run types --workspace=@rowan-ui/maplibre",
    "typecheck": "tsc --project tsconfig.typecheck.root.json && tsc --project tsconfig.typecheck.components.json && tsc --project tsconfig.typecheck.react-18.json && tsc --project tsconfig.typecheck.react-19.json && npm run typecheck --workspace=@rowan-ui/maplibre",
    "lint": "npm run tokens:check && npm run css:check && eslint \"src/**/*.js\" \"scripts/**/*.mjs\" \"documentation/*.js\" \".storybook/**/*.js\" \"packages/*/src/**/*.js\" \"packages/*/scripts/**/*.mjs\"",
    "format": "prettier --write \"**/*.{js,jsx,css,md,mdx,json}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,css,md,mdx,json}\""
  },
